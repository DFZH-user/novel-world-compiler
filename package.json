{
  "name": "novel-world-compiler",
  "version": "0.3.0-integrated.15",
  "packageManager": "pnpm@11.19.0",
  "private": true,
  "description": "将长篇小说整理为可追溯、可继续加工的世界工程",
  "author": "小说世界编译器项目",
  "main": "dist-electron/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsup --watch\" \"wait-on tcp:5173 file:dist-electron/main/index.cjs file:dist-electron/preload/index.cjs file:dist-electron/worker/index.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build && tsup && node scripts/assert-node-sqlite-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:large": "vitest run --config vitest.performance.config.ts",
    "test:e2e": "playwright test",
    "test:sillytavern-roundtrip": "cross-env RUN_SILLYTAVERN_CARD_ROUNDTRIP=1 playwright test sillytavern-card-roundtrip.spec.ts",
    "benchmark:graph": "node scripts/benchmark-relationship-graph.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64 --config.electronDist=node_modules/electron/dist --config.directories.output=release/local-script-v3"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "chardet": "2.2.0",
    "cytoscape": "3.34.2",
    "iconv-lite": "0.7.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "segmentit": "^2.0.3",
    "unzipper": "0.12.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/archiver": "6.0.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wait-on": "9.0.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "cn.dfzh.novelworldcompiler",
    "productName": "小说世界",
    "asar": true,
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "third-party-licenses/**"
    ],
    "extraResources": [
      {
        "from": "vendor/sillytavern",
        "to": "sillytavern",
        "filter": [
          "**/*",
          "!data{,/**/*}",
          "!*.log"
        ]
      },
      {
        "from": "vendor/sillytavern/node_modules",
        "to": "sillytavern/node_modules",
        "filter": [
          "**/*",
          "!.cache{,/**/*}"
        ]
      }
    ],
    "directories": {
      "output": "release/integrated15"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-安装版-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-便携版-${version}-${arch}.${ext}",
      "unpackDirName": true
    },
    "afterPack": "scripts/verify-integrated-resources.cjs"
  }
}
